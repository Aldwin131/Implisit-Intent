<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnKirimPesan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kirim Pesan (SMS)"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSetAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Alarm"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSetTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Timer"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etURL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan URL"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnOpenURL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buka Website"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSetEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Calendar Event"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnGetPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ambil Foto (Camera)"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:id="@+id/ivHasil"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Hasil Foto Thumbnail"
        android:scaleType="centerInside" />

</LinearLayout>